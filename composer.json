{
    "name": "lvntr/api-dock",
    "description": "Laravel API documentation and AI export tooling built on dedoc/scramble (MIT).",
    "keywords": [
        "laravel",
        "api",
        "documentation",
        "openapi",
        "scramble",
        "ai",
        "llms-txt"
    ],
    "homepage": "https://github.com/lvntrdev/laravel-api-dock",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Levent Acar",
            "homepage": "https://lvntr.dev",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/lvntrdev/laravel-api-dock/issues",
        "source": "https://github.com/lvntrdev/laravel-api-dock"
    },
    "require": {
        "php": "^8.3",
        "dedoc/scramble": "^0.13",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Lvntr\\ApiDock\\": "src/",
            "LvntR\\ApiDock\\": "src/"
        },
        "files": [
            "src/legacy-namespace.php"
        ]
    },
    "_comment": "autoload.psr-4 'LvntR\\ApiDock\\' and autoload.files src/legacy-namespace.php are a BC shim for the old namespace spelling; remove both in a later minor.",
    "autoload-dev": {
        "psr-4": {
            "Lvntr\\ApiDock\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --testsuite=\"Api Dock\"",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lvntr\\ApiDock\\ApiDockServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
